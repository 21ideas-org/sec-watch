---
import { SITE_TITLE } from '../consts.ts';
const path = Astro.url.pathname;
const here = (p: string) => (path === p || (p !== '/' && path.startsWith(p)) ? 'page' : undefined);
---
<div class="top">
  <span>{SITE_TITLE} · SEC.21IDEAS.ORG</span>
  <button class="tt" type="button" data-theme-toggle aria-label="Сменить тему">ТЕМА</button>
</div>
<nav class="nav">
  <a href="/" aria-current={here('/')}>Сводка</a>
  <a href="/feed" aria-current={here('/feed')}>Инциденты</a>
  <a href="/about" aria-current={here('/about')}>О проекте</a>
  <a href="/support" aria-current={here('/support')}>Поддержать</a>
</nav>

<script>
  const btn = document.querySelector('[data-theme-toggle]');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const stamped = root.getAttribute('data-theme');
    const dark = stamped
      ? stamped === 'dark'
      : window.matchMedia('(prefers-color-scheme: dark)').matches;
    const next = dark ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('sec-theme', next);
    } catch {}
  });
</script>
