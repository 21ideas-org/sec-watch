---
import Urgency from './Urgency.astro';
import type { Incident } from '../lib.ts';
interface Props { entry: Incident; }
const { entry } = Astro.props;
const d = entry.data;
const date = d.pubDate.toLocaleDateString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric' });
const href = d.external ? d.sourceUrl : `/incidents/${entry.id}/`;
---
<div class="row">
  <span class="dt">{date}</span>
  <div>
    <div class="ti">
      {href ? <a href={href} rel={d.external ? 'noopener' : undefined}>{d.title}</a> : d.title}
    </div>
    {d.description && <div class="de">{d.description}</div>}
  </div>
  {
    d.external
      ? <span class="ext">{d.source} ↗</span>
      : <span class="rt"><Urgency tags={d.urgency} /></span>
  }
</div>
