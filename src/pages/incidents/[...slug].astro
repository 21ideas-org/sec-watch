---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Urgency from '../../components/Urgency.astro';
import Thread from '../../components/Thread.astro';
import { ogFor } from '../../consts.ts';
import { allIncidents, dateLong, keepFlags, own, thread, threadStart } from '../../lib.ts';

export async function getStaticPaths() {
  const list = await allIncidents();
  // Хроника собственной страницы не получает: её ссылка ведёт на первоисточник.
  return own(list).map((entry) => ({
    params: { slug: entry.id },
    props: { entry, posts: thread(list, threadStart(list, entry)) },
  }));
}

const { entry, posts } = Astro.props;
const d = entry.data;
const start = posts[0];
// Крошка нужна только апдейту: на начале треда она указывала бы на саму страницу.
const isUpdate = start !== undefined && start.id !== entry.id;
const { Content } = await render(entry);
const date = dateLong(d.pubDate);
---
<Base
  title={d.title}
  description={d.description}
  image={ogFor(d.urgency)}
  type="article"
  pubDate={d.pubDate}
>
  <article class="prose" style="padding-top: 32px">
    <div class="tags">
      <Urgency tags={d.urgency} />
      {d.audience.map((a) => <span class="aud">{a}</span>)}
      <span class="aud when">{date}</span>
    </div>
    {
      isUpdate && (
        <p class="up-of">
          Апдейт инцидента: <a href={`/incidents/${start!.id}/`}>{start!.data.title}</a>
        </p>
      )
    }
    <h1 set:html={keepFlags(d.title)} />
    {d.description && <p set:html={keepFlags(d.description)} />}

    {
      d.action && (
        <div class="action panel">
          <div class="k">Что делать</div>
          <p set:html={keepFlags(d.action)} />
        </div>
      )
    }

    <Content />

    <Thread posts={posts} current={entry.id} />

    {
      d.links.length > 0 && (
        <div class="links">
          <h2>Первоисточники</h2>
          <ul>
            {d.links.map((l) => (
              <li><a href={l.url} rel="noopener">{l.label}</a></li>
            ))}
          </ul>
        </div>
      )
    }

    {
      d.telegramUrl && (
        <p class="note">
          Это оповещение в Telegram: <a href={d.telegramUrl} rel="noopener">пост</a>
        </p>
      )
    }
  </article>
</Base>
