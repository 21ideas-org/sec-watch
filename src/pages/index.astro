---
import Base from '../layouts/Base.astro';
import Counter from '../components/Counter.astro';
import Row from '../components/Row.astro';
import Urgency from '../components/Urgency.astro';
import UnknownStatuses from '../components/UnknownStatuses.astro';
import { SITE_NAME, SITE_DESCRIPTION, urgencyAccent } from '../consts.ts';
import { allIncidents, own, archive, counterAnchor, dateShort, stats } from '../lib.ts';
import { displayUrgency } from '../status.ts';

const list = await allIncidents();
const posts = own(list);
const latest = posts[0];
const rest = posts.slice(1, 6);
const hist = archive(list).slice(0, 8);
const anchor = counterAnchor(list);
const s = stats(list);
const latestDate = latest && dateShort(latest.data.pubDate);
const latestUrgency = latest ? displayUrgency(latest.data) : [];
---
<Base title={SITE_NAME} description={SITE_DESCRIPTION}>
  <section class="board panel">
    <Counter since={anchor} />
    <div class="stats">
      <span class="hot">без патча<b>{s.unpatched}</b></span>
      <span>за год<b>{s.lastYear}</b></span>
      {/* Оповещения, а не инциденты: у аварии Core Lightning их семь на один
          инцидент, и обе цифры отвечают на разные вопросы. Подпись короткая, как
          у соседей: полная («всего оповещений») роняла пару на вторую строку на
          телефоне, а объясняет её всё равно заголовок панели, а не она сама. */}
      <span>всего<b>{posts.length}</b></span>
    </div>
  </section>

  {
    latest && (
      <section class="sec">
        {/* Тот же .sec-h, что у «Ранее» и «Хроник», и так же ведёт туда, куда
            указывает, — на сам инцидент. Ранг один, значит и вид, и поведение одни. */}
        <div class="sec-h"><h2><a href={`/incidents/${latest.id}/`}>Последний инцидент</a></h2></div>
        <article class="card panel" style={`--accent: ${urgencyAccent(latestUrgency)}`}>
          <div class="tags">
            <Urgency tags={latestUrgency} />
            <UnknownStatuses status={latest.data} />
            {latest.data.audience.map((a) => <span class="aud">{a}</span>)}
            <span class="aud when">{latestDate}</span>
          </div>
          <h2><a href={`/incidents/${latest.id}/`}>{latest.data.title}</a></h2>
          <p>{latest.data.description}</p>
          <a class="go" href={`/incidents/${latest.id}/`}>Подробности →</a>
        </article>
      </section>
    )
  }

  {
    rest.length > 0 && (
      <section class="sec">
        {/* Как и у хроник: заголовок ведёт в ленту, отдельной ссылки справа нет. */}
        <div class="sec-h"><h2><a href="/feed">Ранее</a></h2></div>
        <div class="rows">{rest.map((e) => <Row entry={e} />)}</div>
      </section>
    )
  }

  {
    hist.length > 0 && (
      <section class="sec">
        {/* Заголовок — ссылка на ту же секцию в ленте: на главной хроника обрезана
            восемью строками, и «показать остальные» здесь единственное, что нужно. */}
        <div class="sec-h"><h2><a href="/feed#archive">Хроники</a></h2></div>
        <div class="rows arch">{hist.map((e) => <Row entry={e} />)}</div>
      </section>
    )
  }
</Base>
