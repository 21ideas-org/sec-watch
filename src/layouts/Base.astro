---
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
}
const props = Astro.props;
---
<html lang="ru">
  <head>
    <BaseHead {...props} />
  </head>
  <body>
    <div class="shell">
      <Nav />
      <slot />
      <Footer />
    </div>
  </body>
</html>
